package-as: SideQuest

# The addon lives in SideQuest/ so the repo root can hold tests, tooling and the uploader. move-folders makes that
# folder the shipped addon; nothing else in the repo is packaged.
move-folders:
  SideQuest/SideQuest: SideQuest

ignore:
  - tests
  - uploader
  - .github
  - .impeccable
  - .luacheckrc
  - .pkgmeta
  - PRODUCT.md
  - DESIGN.md
